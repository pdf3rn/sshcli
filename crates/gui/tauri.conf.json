{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "sshcli",
  "version": "0.1.0",
  "identifier": "com.sshcli.desktop",
  "build": {
    "beforeDevCommand": "npm run web:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "sshcli",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Cliente SSH de escritorio",
    "longDescription": "Cliente SSH multiplataforma con interfaz gráfica tipo Termius: sesiones, SFTP y túneles."
  }
}
