#!/usr/bin/env bash
set -euo pipefail

usage() {
  printf '%s\n' "Usage: bin/release [--dry]"
}

dry_run=false
case "${1:-}" in
  "") ;;
  --dry) dry_run=true ;;
  -h|--help) usage; exit 0 ;;
  *) usage >&2; exit 2 ;;
esac

for command in git git-cliff cargo; do
  command -v "$command" >/dev/null || {
    printf 'Required command not found: %s\n' "$command" >&2
    exit 1
  }
done

if ! "$dry_run"; then
  git diff --quiet && git diff --cached --quiet || {
    printf '%s\n' 'Release requires a clean worktree.' >&2
    exit 1
  }
fi

# The single source of truth for the version is the workspace package version.
current_version=$(sed -n 's/^version = "\([0-9][^"]*\)"/\1/p' Cargo.toml | head -n1)
if [[ -z "$current_version" ]]; then
  printf '%s\n' 'workspace package version not found in Cargo.toml' >&2
  exit 1
fi

if latest_tag=$(git describe --tags --match 'v[0-9]*' --abbrev=0 2>/dev/null); then
  candidate_version=$(git-cliff --config cliff.toml --bumped-version)
  candidate_version="${candidate_version#v}"
else
  latest_tag=""
  candidate_version="1.0.0"
fi

# Compare two X.Y.Z semver strings; exit 0 if a > b, else 1.
semver_greater() {
  local IFS=.
  local -a a=($1) b=($2)
  local i
  for i in 0 1 2; do
    local an=${a[$i]:-0} bn=${b[$i]:-0}
    (( an > bn )) && return 0
    (( an < bn )) && return 1
  done
  return 1
}

if ! semver_greater "$candidate_version" "$current_version"; then
  printf 'No versionable commits since %s; current version remains %s.\n' "${latest_tag:-repository start}" "$current_version"
  exit 0
fi

tag="v${candidate_version}"
notes=$(git-cliff --config cliff.toml --unreleased --tag "$tag" --strip header)
printf 'Current version: %s\nCandidate version: %s\nTag: %s\n\n%s\n' "$current_version" "$candidate_version" "$tag" "$notes"

if "$dry_run"; then
  printf '%s\n' 'Dry run: no files, commit, or tag were created.'
  exit 0
fi

cargo test --workspace

# Bump the workspace package version in Cargo.toml.
sed -i.bak "s/^version = \"${current_version}\"/version = \"${candidate_version}\"/" Cargo.toml
rm -f Cargo.toml.bak

git-cliff --config cliff.toml --tag "$tag" --output CHANGELOG.md

git add Cargo.toml Cargo.lock CHANGELOG.md
git commit -m "chore(release): ${tag}"
git tag -a "$tag" -m "Release ${tag}"
printf 'Created release commit and local tag %s. Publish with: git push origin HEAD --follow-tags\n' "$tag"